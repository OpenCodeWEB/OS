# Immutable cache for hashed assets (1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# No cache for HTML — always check for fresh build
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Service Worker must NEVER be cached (bypass for updates)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Cache favicon and PWA icons aggressively
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/globe-icon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Cache Web Manifest
/site.webmanifest
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Don't cache API responses by default — functions set their own
/api/*
  Cache-Control: no-cache, no-store, must-revalidate
